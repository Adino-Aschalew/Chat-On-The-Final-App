    "pdf-lib": "^1.17.1",
    "redis": "^4.6.12",
    "sequelize": "^6.35.2",
    "sharp": "^0.33.1",
    "socket.io": "^4.7.5",
    "swagger-jsdoc": "^6.2.8",
