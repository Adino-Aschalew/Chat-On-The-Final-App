{
  "name": "chat-backend",
  "version": "1.0.0",
  "description": "Production-ready real-time chat application backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/seeders/createAdmin.js",
    "seed:sample": "node src/seeders/sampleData.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "migrate": "node src/config/migrate.js",
